    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.33",
    "@tanstack/router-plugin": "1.168.35",
    "@tanstack/router-utils": "1.162.2",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@testing-library/dom": "10.4.0",
